#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT/frontend"
npm ci --cache "$ROOT/.tools/npm-cache" --no-audit --no-fund
npm run build
cd "$ROOT"
./scripts/mvn -f backend/pom.xml clean verify
printf '\nClientFlow built and tested: backend/target/clientflow-1.0.0.jar\n'
