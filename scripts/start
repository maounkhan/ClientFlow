#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${PORT:-8080}"
if curl -fsS "http://127.0.0.1:$PORT/api/v1/auth/demo-info" 2>/dev/null | grep -q 'ClientFlow'; then
 printf '\nClientFlow is already running at http://127.0.0.1:%s\n' "$PORT"
 if command -v open >/dev/null 2>&1 && [ "${CLIENTFLOW_NO_BROWSER:-0}" != "1" ]; then open "http://127.0.0.1:$PORT"; fi
 exit 0
fi
if ! command -v java >/dev/null 2>&1; then printf 'Java 21 or newer is required.\n';exit 1;fi
if [ "${1:-}" = "--build" ] || [ ! -f "$ROOT/backend/target/clientflow-1.0.0.jar" ]; then "$ROOT/scripts/build"; fi
printf '\nClientFlow demo: http://127.0.0.1:%s\nChoose a demo role on the sign-in screen. Press Ctrl+C to stop.\n\n' "$PORT"
cd "$ROOT/backend"
if command -v open >/dev/null 2>&1 && [ "${CLIENTFLOW_NO_BROWSER:-0}" != "1" ]; then
 (for attempt in {1..40}; do if curl -fsS "http://127.0.0.1:$PORT/actuator/health" >/dev/null 2>&1; then open "http://127.0.0.1:$PORT";break;fi;sleep 1;done) &
fi
exec java -jar target/clientflow-1.0.0.jar
